---
export interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
  tipo?: 'website' | 'article';
  sinIndexar?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

import '../styles/global.css';

const {
  titulo,
  descripcion,
  imagen,
  tipo = 'website',
  sinIndexar = false,
  jsonLd,
} = Astro.props;

const sitio = Astro.site ?? new URL('https://leecuentitos.com');
const canonica = new URL(Astro.url.pathname, sitio).href;
const imagenAbs = imagen ? new URL(imagen, sitio).href : new URL('/og-default.jpg', sitio).href;
const tituloCompleto = titulo.includes('Lee Cuentitos') ? titulo : `${titulo} · Lee Cuentitos`;
const adsense = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const jsonLdLista = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {sinIndexar && <meta name="robots" content="noindex, nofollow" />}
    {!sinIndexar && <link rel="canonical" href={canonica} />}

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content="Lee Cuentitos" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:alt" content={titulo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbs} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#7a1236" />
    <link rel="alternate" type="application/rss+xml" title="Lee Cuentitos" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {adsense && <meta name="google-adsense-account" content={adsense} />}

    <script is:inline>
      (() => {
        try {
          const guardado = localStorage.getItem('lc-tema');
          const prefiere = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (guardado === 'noche' || (!guardado && prefiere)) {
            document.documentElement.dataset.tema = 'noche';
          }
        } catch (e) {}
      })();
    </script>

    <slot name="head" />

    {jsonLdLista.map((dato) => (
      <script type="application/ld+json" set:html={JSON.stringify(dato)} />
    ))}

    {adsense && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`}
        crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <a class="salto-contenido" href="#contenido">Saltar al contenido</a>
    <slot name="progreso" />
    <slot name="header" />
    <main id="contenido">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
