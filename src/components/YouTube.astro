---
import Icon from './Icon.astro';

export interface Props {
  video: string;
  titulo: string;
  clase?: string;
}

const { video, titulo, clase = '' } = Astro.props;

function extraerId(valor: string): string {
  const v = valor.trim();
  if (!v) return '';
  const patrones = [
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([\w-]{6,})/,
    /^([\w-]{11})$/,
  ];
  for (const p of patrones) {
    const m = v.match(p);
    if (m) return m[1];
  }
  return v;
}

const id = extraerId(video);
const miniatura = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

{
  id && (
    <figure class={`my-10 ${clase}`}>
      <div class="group relative overflow-hidden border border-linea bg-morado-fuerte" data-video-youtube={id}>
        <img
          src={miniatura}
          alt={`Miniatura del video: ${titulo}`}
          width="480"
          height="360"
          loading="lazy"
          decoding="async"
          class="aspect-video w-full scale-[1.35] object-cover opacity-90 transition-opacity group-hover:opacity-100"
        />
        <button
          type="button"
          class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-gradient-to-t from-black/70 via-black/10 to-transparent text-white"
          aria-label={`Reproducir el video de YouTube: ${titulo}`}
        >
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/95 text-carmesi transition-transform group-hover:scale-110">
            <Icon nombre="play" tamano={30} />
          </span>
          <span class="text-[11px] font-bold uppercase tracking-[0.14em]">Ver el cuento en video</span>
        </button>
      </div>
      <figcaption class="mt-2 text-center text-[12px] text-tinta-suave">
        Video del canal de Lee Cuentitos · al reproducirlo se conecta con YouTube
      </figcaption>
    </figure>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-video-youtube]').forEach((caja) => {
    const boton = caja.querySelector('button');
    boton?.addEventListener('click', () => {
      const id = caja.dataset.videoYoutube;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = boton.getAttribute('aria-label') ?? 'Video de YouTube';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'aspect-video w-full';
      iframe.loading = 'lazy';
      caja.replaceChildren(iframe);
    });
  });
</script>
