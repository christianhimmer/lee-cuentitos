---
import { Image } from 'astro:assets';
import { nombreSaga, type Cuento } from '../lib/cuentos';
import { portadaDe } from '../lib/imagenes';

export interface Props {
  cuento: Cuento;
  prioridad?: boolean;
  compacta?: boolean;
}

const { cuento, prioridad = false, compacta = false } = Astro.props;
const { data } = cuento;
const saga = nombreSaga(data.saga);
const portada = portadaDe(data.portada);
const url = `/${data.slug}/`;
const etiqueta = data.parte ? `Parte ${String(data.parte).padStart(2, '0')}` : saga || 'Cuento';
---

<article class="cuento">
  <a href={url} class="cuento-portada" aria-hidden="true" tabindex="-1">
    <Image
      src={portada}
      alt={data.portadaAlt ?? data.title}
      widths={[400, 640, 900]}
      sizes={compacta ? '(min-width: 640px) 320px, 90vw' : '(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw'}
      loading={prioridad ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : 'auto'}
      decoding="async"
    />
  </a>
  <span class="cuento-parte">{etiqueta}</span>
  <h3 class:list={[compacta && 'text-[17px]']}>
    <a href={url} class="enlace-titulo">{data.title}</a>
  </h3>
  <p class="cuento-meta">
    {data.parte && saga ? `${saga} · ` : ''}{data.minutos} min de lectura
  </p>
</article>
