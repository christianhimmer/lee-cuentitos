---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const ruta = Astro.url.pathname;
const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/cuentos/', texto: 'Cuentos' },
  { href: '/sagas/', texto: 'Sagas' },
  { href: '/personajes/', texto: 'Personajes' },
  { href: '/nosotros/', texto: 'Nosotros' },
];
const activo = (href: string) =>
  href === '/' ? ruta === '/' : ruta.startsWith(href.replace(/\/$/, ''));
---

<header class="header sticky top-0 z-50">
  <div class="contenedor header-inner">
    <a href="/" aria-label="Lee Cuentitos, ir al inicio">
      <Logo variante="header" />
    </a>

    <nav class="nav-principal" aria-label="Navegación principal">
      {enlaces.map((e) => (
        <a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>{e.texto}</a>
      ))}
    </nav>

    <div class="acciones-header">
      <div class="busqueda-header hidden lg:block">
        <form action="/buscar/" method="get" role="search" class="flex items-center gap-2 border-b border-linea px-1 py-1.5">
          <Icon nombre="buscar" tamano={15} clase="text-tinta-suave" />
          <input
            type="search"
            name="q"
            placeholder="Buscar…"
            aria-label="Buscar cuentos"
            class="w-32 bg-transparent text-[13px] text-tinta outline-none placeholder:text-tinta-suave/70"
          />
        </form>
      </div>
      <button
        type="button"
        id="boton-tema"
        class="boton-icono"
        aria-label="Cambiar entre modo día y noche"
        title="Modo día / noche"
      >
        <span data-icono="luna"><Icon nombre="luna" tamano={17} /></span>
        <span data-icono="sol" class="hidden"><Icon nombre="sol" tamano={17} /></span>
      </button>
      <a href="/buscar/" class="boton-icono lg:hidden" aria-label="Buscar cuentos">
        <Icon nombre="buscar" tamano={17} />
      </a>
      <a href="/cuentos/" class="boton boton-primario hidden sm:inline-flex">Empezar a leer</a>
      <button
        type="button"
        id="boton-menu"
        class="boton-icono lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <Icon nombre="menu" tamano={19} />
      </button>
    </div>
  </div>

  <div id="menu-movil" class="hidden border-t border-linea bg-papel px-5 pb-5 pt-3 lg:hidden">
    <nav class="flex flex-col" aria-label="Navegación móvil">
      {enlaces.map((e) => (
        <a
          href={e.href}
          class:list={[
            'border-b border-linea-suave py-3 text-[15px] font-bold',
            activo(e.href) ? 'text-carmesi' : 'text-morado',
          ]}
        >
          {e.texto}
        </a>
      ))}
      <a href="/cuentos/" class="boton boton-primario mt-4">Empezar a leer</a>
    </nav>
  </div>
</header>

<script>
  const botonTema = document.getElementById('boton-tema');
  botonTema?.addEventListener('click', () => {
    const raiz = document.documentElement;
    const esNoche = raiz.dataset.tema === 'noche';
    if (esNoche) {
      delete raiz.dataset.tema;
      localStorage.setItem('lc-tema', 'dia');
    } else {
      raiz.dataset.tema = 'noche';
      localStorage.setItem('lc-tema', 'noche');
    }
  });

  const botonMenu = document.getElementById('boton-menu');
  const menu = document.getElementById('menu-movil');
  botonMenu?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    botonMenu.setAttribute('aria-expanded', String(abierto));
    botonMenu.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  });
</script>
