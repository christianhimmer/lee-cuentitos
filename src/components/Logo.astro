---
import completo from '../assets/logo-completo.svg?raw';
import libro from '../assets/logo-libro.svg?raw';

export interface Props {
  variante?: 'header' | 'footer' | 'agua';
  clase?: string;
}

const { variante = 'header', clase = '' } = Astro.props;
const svg = variante === 'agua' ? libro : completo;
const clases = {
  header: 'logoHeader',
  footer: 'logoFooter',
  agua: 'marca-agua',
}[variante];
---

<span class:list={['logo', clases, clase]} set:html={svg} />
