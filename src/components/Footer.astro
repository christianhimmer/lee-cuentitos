---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const enlaces = [
  { href: '/cuentos/', texto: 'Cuentos' },
  { href: '/sagas/', texto: 'Sagas' },
  { href: '/personajes/', texto: 'Personajes' },
  { href: '/nosotros/', texto: 'Nosotros' },
  { href: '/contacto/', texto: 'Contacto' },
];
---

<footer class="footer">
  <div class="contenedor">
    <div class="footer-top">
      <a href="/" aria-label="Lee Cuentitos, ir al inicio">
        <Logo variante="footer" />
      </a>
      <nav class="footer-links" aria-label="Enlaces del pie">
        {enlaces.map((e) => <a href={e.href}>{e.texto}</a>)}
      </nav>
      <div class="footer-social">
        <a href="https://www.instagram.com/leecuentitos/" target="_blank" rel="me noopener" aria-label="Instagram de Lee Cuentitos">
          <Icon nombre="instagram" tamano={16} />
        </a>
        <a href="https://www.youtube.com/@leecuentitos" target="_blank" rel="me noopener" aria-label="Canal de YouTube de Lee Cuentitos">
          <Icon nombre="youtube" tamano={16} />
        </a>
        <a href="https://www.facebook.com/leecuentitos" target="_blank" rel="me noopener" aria-label="Facebook de Lee Cuentitos">
          <Icon nombre="facebook" tamano={16} />
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Lee Cuentitos · Cuentos originales para leer en familia</p>
      <p>
        <a href="/privacidad/">Privacidad y cookies</a> · Hecho a mano por
        <a href="https://christianhimmer.com" target="_blank" rel="author noopener">Christian Himmer</a>
      </p>
    </div>
  </div>
</footer>
