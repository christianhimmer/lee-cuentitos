---
import { Image } from 'astro:assets';
import foto from '../assets/autor/christian-himmer.webp';
import { fechaLarga, nombreSaga, nombreArco } from '../lib/cuentos';

interface Props {
  fecha: Date;
  actualizado?: Date;
  minutos: number;
  saga?: string;
  arco?: string;
  parte?: number;
}

const { fecha, actualizado, minutos, saga, arco, parte } = Astro.props;

const sagaNombre = nombreSaga(saga);
const arcoNombre = nombreArco(arco);
const revisado = actualizado && actualizado.getTime() !== fecha.getTime();
---

<section class="mx-auto mt-14 max-w-[52rem] border-t border-linea pt-8" aria-labelledby="sobre-este-cuento">
  <div class="grid gap-6 sm:grid-cols-[auto_1fr] sm:items-center">
    <Image
      src={foto}
      alt="Retrato de Christian Himmer, editor de Lee Cuentitos"
      width={140}
      height={213}
      class="h-[213px] w-[140px] bg-[#f3eadf] object-contain object-bottom"
      loading="lazy"
      decoding="async"
    />
    <div>
      <p class="etiqueta" id="sobre-este-cuento">Sobre este cuento</p>
      <p class="mt-1 font-titulo text-xl">
        Dirección editorial: <a href="/nosotros/#autor" class="font-semibold text-morado underline decoration-linea decoration-1 underline-offset-4 hover:text-carmesi">Christian Himmer</a>
      </p>
      <p class="mt-1 max-w-xl text-[0.92rem] leading-relaxed text-tinta-suave">
        Papá de Damián y diseñador web. Elige, descarta y publica los cuentos; las historias y
        las portadas se crean con inteligencia artificial.
      </p>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-[12px] font-bold uppercase tracking-[0.08em] text-verde">
        <li>Texto creado con IA</li>
        <li>Publicado el {fechaLarga(fecha)}</li>
        {revisado && actualizado && <li>Revisado el {fechaLarga(actualizado)}</li>}
        <li>{minutos} min de lectura</li>
        {sagaNombre && (
          <li>
            <a href={`/sagas/${saga}/`} class="underline decoration-linea decoration-1 underline-offset-4 hover:text-morado">
              {arcoNombre ? `${arcoNombre}, parte ${String(parte ?? 0).padStart(2, '0')}` : sagaNombre}
            </a>
          </li>
        )}
      </ul>
    </div>
  </div>

  <div class="mt-8 border-t border-linea pt-6">
    <h2 class="font-titulo text-xl text-morado">Cómo se hizo este cuento</h2>
    <p class="mt-2 text-[0.98rem] leading-relaxed text-tinta-suave">
      Empezó con una petición de Damián: otro cuento para esa noche. Christian le pasó la idea a
      la IA, la historia volvió hecha un borrador y la portada también se generó así. Después vino
      lo importante: decidir si valía la pena. Aquí no hay truco ni secreto, solo un papá, un niño
      y una IA que escribe rápido.
    </p>
  </div>
</section>
