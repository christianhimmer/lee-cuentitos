---
export interface Props {
  slot?: string;
  formato?: 'horizontal' | 'rectangulo' | 'vertical';
  clase?: string;
}

const { slot = '', formato = 'horizontal', clase = '' } = Astro.props;
import { ANALYTICS } from '../data/analytics';

const cliente = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? ANALYTICS.adsense;
const esDev = import.meta.env.DEV;

const medidas = {
  horizontal: { clase: 'min-h-[90px] max-w-[728px]', etiqueta: '728 × 90' },
  rectangulo: { clase: 'min-h-[250px] max-w-[336px]', etiqueta: '336 × 250' },
  vertical: { clase: 'min-h-[600px] max-w-[300px]', etiqueta: '300 × 600' },
}[formato];
---

{
  cliente && slot ? (
    <aside class={`mx-auto w-full ${medidas.clase} ${clase}`} aria-label="Publicidad">
      <p class="mb-1 text-center text-[10px] font-bold uppercase tracking-[0.16em] text-tinta-suave/60">Publicidad</p>
      <ins
        class="adsbygoogle block"
        style="display:block"
        data-ad-client={cliente}
        data-ad-slot={slot}
        data-ad-format={formato === 'horizontal' ? 'auto' : undefined}
        data-full-width-responsive="true"
      />
    </aside>
  ) : (
    esDev && (
      <aside class={`mx-auto w-full ${medidas.clase} ${clase}`} aria-label="Espacio publicitario">
        <div class="flex h-full flex-col items-center justify-center gap-1 border border-dashed border-linea px-4 py-8 text-center text-tinta-suave">
          <span class="text-[10px] font-bold uppercase tracking-[0.16em]">Publicidad</span>
          <span class="text-xs">{medidas.etiqueta}</span>
        </div>
      </aside>
    )
  )
}
