---
import { ANALYTICS } from '../data/analytics';
---

<section id="lc-cookies" class="cookies" role="dialog" aria-modal="false" aria-labelledby="lc-cookies-titulo" hidden>
  <div class="cookies-caja">
    <div class="cookies-texto">
      <p id="lc-cookies-titulo" class="cookies-titulo">Cookies y datos</p>
      <p class="cookies-desc">
        Usamos cookies necesarias para que el sitio funcione. Si aceptas, también medimos las visitas
        y mostramos anuncios. Puedes elegir por categoría y cambiarlo cuando quieras.
        <a href="/privacidad/">Más información</a>.
      </p>
    </div>

    <div class="cookies-acciones">
      <button type="button" class="boton boton-secundario" data-cookies="necesarias">Solo necesarias</button>
      <button type="button" class="boton boton-primario" data-cookies="todo">Aceptar todo</button>
      <button type="button" class="cookies-config" data-cookies="configurar">Preferencias</button>
    </div>
  </div>

  <div id="lc-cookies-prefs" class="cookies-prefs" hidden>
    <label class="cookies-opcion">
      <input type="checkbox" checked disabled />
      <span><strong>Necesarias</strong><small>Preferencias de lectura y seguridad. Siempre activas.</small></span>
    </label>
    <label class="cookies-opcion">
      <input type="checkbox" id="lc-pref-analitica" />
      <span><strong>Analítica</strong><small>Google Analytics, Microsoft Clarity y Ahrefs. Nos dicen qué cuentos se leen más.</small></span>
    </label>
    <label class="cookies-opcion">
      <input type="checkbox" id="lc-pref-publicidad" />
      <span><strong>Publicidad</strong><small>Google AdSense y Meta Pixel. Permiten mantener el sitio gratis.</small></span>
    </label>
    <div class="cookies-guardar">
      <button type="button" class="boton boton-primario" data-cookies="guardar">Guardar preferencias</button>
    </div>
  </div>
</section>

<script define:vars={{ ANALYTICS }}>
  const CLAVE = 'lc-consent-v1';
  const caja = document.getElementById('lc-cookies');
  const prefs = document.getElementById('lc-cookies-prefs');
  const checkAnalitica = document.getElementById('lc-pref-analitica');
  const checkPublicidad = document.getElementById('lc-pref-publicidad');

  function leer() {
    try {
      return JSON.parse(localStorage.getItem(CLAVE) || 'null');
    } catch (e) {
      return null;
    }
  }

  function guardar(estado) {
    localStorage.setItem(CLAVE, JSON.stringify({ ...estado, fecha: new Date().toISOString() }));
    caja?.setAttribute('hidden', '');
    cargar(estado);
  }

  function cargarAnalitica() {
    if (window.__lcAnalitica) return;
    window.__lcAnalitica = true;

    // Google Analytics 4
    const ga = document.createElement('script');
    ga.async = true;
    ga.src = `https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4}`;
    document.head.appendChild(ga);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', ANALYTICS.ga4, { anonymize_ip: true });

    // Microsoft Clarity
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', ANALYTICS.clarity);

    // Ahrefs Web Analytics
    const ah = document.createElement('script');
    ah.async = true;
    ah.src = 'https://analytics.ahrefs.com/analytics.js';
    ah.setAttribute('data-key', ANALYTICS.ahrefs);
    document.head.appendChild(ah);
  }

  function cargarPublicidad() {
    if (window.__lcPublicidad) return;
    window.__lcPublicidad = true;

    // Google AdSense
    const ads = document.createElement('script');
    ads.async = true;
    ads.crossOrigin = 'anonymous';
    ads.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ANALYTICS.adsense}`;
    ads.onload = () => {
      document.querySelectorAll('.adsbygoogle').forEach(() => {
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
      });
    };
    document.head.appendChild(ads);

    // Meta Pixel
    (function (f, b, e, v, n, t, s) {
      if (f.fbq) return;
      n = f.fbq = function () {
        n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
      };
      if (!f._fbq) f._fbq = n;
      n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
      t = b.createElement(e); t.async = true; t.src = v;
      s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
    })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
    window.fbq('init', ANALYTICS.metaPixel);
    window.fbq('track', 'PageView');
  }

  function cargar(estado) {
    if (!estado) return;
    if (estado.analitica) cargarAnalitica();
    if (estado.publicidad) cargarPublicidad();
  }

  window.lcAbrirCookies = function () {
    const actual = leer();
    if (checkAnalitica) checkAnalitica.checked = Boolean(actual?.analitica);
    if (checkPublicidad) checkPublicidad.checked = Boolean(actual?.publicidad);
    prefs?.removeAttribute('hidden');
    caja?.removeAttribute('hidden');
  };

  caja?.querySelectorAll('[data-cookies]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const accion = boton.getAttribute('data-cookies');
      if (accion === 'todo') {
        guardar({ necesaria: true, analitica: true, publicidad: true });
      } else if (accion === 'necesarias') {
        guardar({ necesaria: true, analitica: false, publicidad: false });
      } else if (accion === 'configurar') {
        prefs?.toggleAttribute('hidden');
      } else if (accion === 'guardar') {
        guardar({
          necesaria: true,
          analitica: Boolean(checkAnalitica?.checked),
          publicidad: Boolean(checkPublicidad?.checked),
        });
      }
    });
  });

  const actual = leer();
  if (!actual) {
    caja?.removeAttribute('hidden');
  } else {
    cargar(actual);
  }
</script>
