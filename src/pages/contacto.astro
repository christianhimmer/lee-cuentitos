---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const migas = [
  { texto: 'Inicio', href: '/' },
  { texto: 'Contacto' },
];

const formId = import.meta.env.PUBLIC_FORMSPREE_ID;
const correo = 'hola@leecuentitos.com';
---

<Base
  titulo="Contacto"
  descripcion="Escríbenos si tienes una sugerencia, un cuento favorito, una colaboración o una duda sobre Lee Cuentitos."
  imagen="/og-default.jpg"
>
  <TopBar slot="header" />
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="contenedor max-w-4xl py-12">
    <Breadcrumbs items={migas} />
    <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.16em] text-ambar">Hablemos</p>
    <h1 class="mt-2 text-[2.5rem] sm:text-5xl">Contacto</h1>
    <p class="mt-3 max-w-2xl text-[1.05rem] leading-relaxed text-tinta-suave">
      ¿Tienes una sugerencia, una idea para un cuento o quieres contar tu experiencia leyendo con
      tus hijos? Escríbenos. Leemos todos los mensajes.
    </p>

    <div class="mt-10 grid gap-8 md:grid-cols-[1.2fr_0.8fr]">
      <form
        class="rounded-none border border-linea bg-superficie p-6"
        action={formId ? `https://formspree.io/f/${formId}` : `mailto:${correo}`}
        method={formId ? 'POST' : 'GET'}
        enctype="text/plain"
      >
        <div class="mb-4">
          <label for="nombre" class="mb-1.5 block text-[0.85rem] font-extrabold text-tinta">Nombre</label>
          <input id="nombre" name="nombre" required autocomplete="name" class="w-full rounded-[2px] border border-linea bg-crema px-3 py-2.5 text-[0.95rem] outline-none focus:border-vino/40" />
        </div>
        <div class="mb-4">
          <label for="email" class="mb-1.5 block text-[0.85rem] font-extrabold text-tinta">Correo electrónico</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="w-full rounded-[2px] border border-linea bg-crema px-3 py-2.5 text-[0.95rem] outline-none focus:border-vino/40" />
        </div>
        <div class="mb-5">
          <label for="mensaje" class="mb-1.5 block text-[0.85rem] font-extrabold text-tinta">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="6" required class="w-full rounded-[2px] border border-linea bg-crema px-3 py-2.5 text-[0.95rem] outline-none focus:border-vino/40"></textarea>
        </div>
        <label class="mb-5 flex items-start gap-2 text-[0.82rem] text-tinta-suave">
          <input type="checkbox" name="acepto" required class="mt-1" />
          <span>Acepto que mis datos se usen solo para responder este mensaje, según la <a href="/privacidad/" class="font-bold text-teal underline">política de privacidad</a>.</span>
        </label>
        <button type="submit" class="boton boton-primario w-full sm:w-auto">
          Enviar mensaje <Icon nombre="flecha" tamano={16} />
        </button>
        {!formId && (
          <p class="mt-3 text-[0.78rem] text-tinta-suave">
            Se abrirá tu programa de correo. Si prefieres, escríbenos directo a
            <a href={`mailto:${correo}`} class="font-bold text-teal underline">{correo}</a>.
          </p>
        )}
      </form>

      <aside class="space-y-4">
        <div class="rounded-none border border-linea bg-crema-2 p-5">
          <h2 class="font-titulo text-lg">Correo directo</h2>
          <a href={`mailto:${correo}`} class="mt-1 inline-block font-bold text-teal underline">{correo}</a>
        </div>
        <div class="rounded-none border border-linea bg-crema-2 p-5">
          <h2 class="font-titulo text-lg">Redes</h2>
          <ul class="mt-2 space-y-2 text-[0.92rem]">
            <li><a href="https://www.instagram.com/leecuentitos/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-bold text-teal hover:underline"><Icon nombre="instagram" tamano={16} /> Instagram</a></li>
            <li><a href="https://www.youtube.com/@leecuentitos" target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-bold text-teal hover:underline"><Icon nombre="youtube" tamano={16} /> YouTube</a></li>
          </ul>
        </div>
        <div class="rounded-none border border-linea bg-crema-2 p-5 text-[0.9rem] text-tinta-suave">
          <h2 class="font-titulo text-lg text-tinta">Sobre los cuentos</h2>
          <p class="mt-1">Si quieres proponer una idea o enviar un cuento, cuéntanos de quién es y para qué edad es. Respondemos en pocos días.</p>
        </div>
      </aside>
    </div>
  </div>
</Base>
