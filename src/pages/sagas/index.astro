---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import TopBar from '../../components/TopBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { todosLosCuentos, sagas, arcos } from '../../lib/cuentos';
import { personajesPorSlug } from '../../data/personajes';
import { imagen } from '../../lib/imagenes';

const cuentos = await todosLosCuentos();

const lista = sagas
  .map((s) => {
    const propios = cuentos.filter((c) => c.data.saga === s.slug);
    const arcosPropios = arcos.filter((a) => a.saga === s.slug);
    return { ...s, total: propios.length, arcos: arcosPropios };
  })
  .filter((s) => s.total > 0);

const sueltos = cuentos.filter((c) => !c.data.saga);
---

<Base
  titulo="Sagas de cuentos"
  descripcion="Explora las sagas de Lee Cuentitos: Tom, Lucas y Max, las aventuras de Damián y el mundo de Guijarro. Historias conectadas para leer en orden o por capítulos."
  imagen={imagen(lista[0].portada).src}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Sagas de Lee Cuentitos',
    hasPart: lista.map((s) => ({
      '@type': 'CreativeWorkSeries',
      name: s.nombre,
      url: `https://leecuentitos.com/sagas/${s.slug}/`,
      numberOfEpisodes: s.total,
    })),
  }}
>
  <TopBar slot="header" />
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="border-b border-linea bg-papel-2">
    <div class="contenedor py-12">
      <p class="etiqueta">Mundos que continúan</p>
      <h1 class="mt-2 text-[2.4rem] sm:text-5xl">Sagas</h1>
      <p class="mt-3 max-w-2xl text-[1.05rem] leading-relaxed text-tinta-suave">
        Cada saga es un mundo con sus propios personajes y aventuras. Puedes leer los cuentos en orden
        o entrar por el que más te llame.
      </p>
    </div>
  </div>

  <div class="contenedor py-12">
    <div class="grid gap-14">
      {lista.map((s, i) => (
        <section class:list={['grid gap-8 md:grid-cols-[0.9fr_1.1fr] md:items-center', i > 0 && 'border-t border-linea pt-14']}>
          <a href={`/sagas/${s.slug}/`} class="relative block overflow-hidden">
            <Image
              src={imagen(s.portada)}
              alt=""
              width={900}
              height={560}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 42vw, 92vw"
              loading="lazy"
              class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03]"
            />
            <span class="absolute left-4 top-4 bg-naranja px-2 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-white">{s.total} cuentos</span>
          </a>

          <div>
            <p class="etiqueta">{s.total} cuentos</p>
            <h2 class="mt-2 text-[2rem] leading-tight">
              <a href={`/sagas/${s.slug}/`} class="hover:text-carmesi">{s.nombre}</a>
            </h2>
            <p class="mt-2 font-bold text-verde">{s.lema}</p>
            <p class="mt-3 text-[16px] leading-relaxed text-tinta-suave">{s.descripcionLarga}</p>

            <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
              {s.personajes.map((p) => {
                const personaje = personajesPorSlug[p];
                if (!personaje) return null;
                return (
                  <a href={`/personajes/${personaje.slug}/`} class="text-[13px] font-bold text-verde underline decoration-linea underline-offset-4 hover:text-morado">
                    {personaje.nombre}
                  </a>
                );
              })}
            </div>

            {s.arcos.length > 0 && (
              <div class="mt-5 space-y-1.5">
                {s.arcos.map((a) => (
                  <a href={`/sagas/${a.slug}/`} class="flex items-center justify-between border-t border-linea py-2 text-[13px] font-bold text-morado hover:text-carmesi">
                    <span>Arco: {a.nombre} ({a.total} partes)</span>
                    <Icon nombre="flecha" tamano={14} />
                  </a>
                ))}
              </div>
            )}

            <a href={`/sagas/${s.slug}/`} class="enlace-flecha mt-6">
              Entrar a la saga <Icon nombre="flecha" tamano={15} />
            </a>
          </div>
        </section>
      ))}
    </div>

    {sueltos.length > 0 && (
      <section class="mt-16 border-t border-linea pt-10">
        <h2 class="text-[1.6rem]">Cuentos independientes</h2>
        <p class="mt-1 text-tinta-suave">Historias que aún no pertenecen a una saga.</p>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
          {sueltos.map((c) => (
            <a href={`/${c.data.slug}/`} class="text-[14px] font-bold text-morado underline decoration-linea underline-offset-4 hover:text-carmesi">
              {c.data.title}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
