---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { todosLosCuentos, sagas, arcos } from '../../lib/cuentos';
import { personajesPorSlug } from '../../data/personajes';
import { imagen } from '../../lib/imagenes';
import PersonajeAvatar from '../../components/PersonajeAvatar.astro';

const cuentos = await todosLosCuentos();

const lista = sagas
  .map((s) => {
    const propios = cuentos.filter((c) => c.data.saga === s.slug);
    const arcosPropios = arcos.filter((a) => a.saga === s.slug);
    return { ...s, total: propios.length, arcos: arcosPropios };
  })
  .filter((s) => s.total > 0);

const sueltos = cuentos.filter((c) => !c.data.saga);
---

<Base
  titulo="Sagas de cuentos"
  descripcion="Explora las sagas de Lee Cuentitos: Tom, Lucas y Max, las aventuras de Damián y el mundo de Guijarro. Historias conectadas para leer en orden o por capítulos."
  imagen={imagen(lista[0].portada).src}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Sagas de Lee Cuentitos',
    hasPart: lista.map((s) => ({
      '@type': 'CreativeWorkSeries',
      name: s.nombre,
      url: `https://leecuentitos.com/sagas/${s.slug}/`,
      numberOfEpisodes: s.total,
    })),
  }}
>
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="border-b border-borde bg-crema-2">
    <div class="contenedor py-12">
      <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.16em] text-ambar">Mundos que continúan</p>
      <h1 class="mt-1 text-[2.4rem] sm:text-5xl">Sagas</h1>
      <p class="mt-3 max-w-2xl text-[1.05rem] leading-relaxed text-tinta-suave">
        Cada saga es un mundo con sus propios personajes y aventuras. Puedes leer los cuentos en orden
        o entrar por el que más te llame.
      </p>
    </div>
  </div>

  <div class="contenedor py-12">
    <div class="grid gap-8">
      {lista.map((s) => (
        <section class="overflow-hidden rounded-2xl border border-borde bg-white shadow-[var(--shadow-suave)] md:grid md:grid-cols-[0.9fr_1.1fr]">
          <a href={`/sagas/${s.slug}/`} class="relative block min-h-[15rem] overflow-hidden">
            <Image
              src={imagen(s.portada)}
              alt=""
              width={900}
              height={506}
              widths={[480, 800, 1200]}
              format="webp"
              sizes="(min-width: 768px) 40vw, 92vw"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-vino-oscuro/50 to-transparent md:bg-gradient-to-r"></div>
            <span class="absolute left-5 top-5 etiqueta bg-ambar text-[#3a2a08]">{s.total} cuentos</span>
          </a>

          <div class="p-6 sm:p-8">
            <h2 class="text-[1.9rem] leading-tight">
              <a href={`/sagas/${s.slug}/`} class="hover:underline hover:decoration-vino/30">{s.nombre}</a>
            </h2>
            <p class="mt-1 font-bold text-teal">{s.lema}</p>
            <p class="mt-3 text-[0.98rem] leading-relaxed text-tinta-suave">{s.descripcionLarga}</p>

            <div class="mt-5 flex flex-wrap gap-2">
              {s.personajes.map((p) => {
                const personaje = personajesPorSlug[p];
                if (!personaje) return null;
                return (
                  <a href={`/personajes/${personaje.slug}/`} class="inline-flex items-center gap-1.5 rounded-full border border-borde px-2.5 py-1 text-[0.8rem] font-bold text-tinta-suave hover:border-vino/30 hover:text-vino">
                    <PersonajeAvatar personaje={personaje} clase="h-6 w-6 border-2" tamano={32} />
                    {personaje.nombre}
                  </a>
                );
              })}
            </div>

            {s.arcos.length > 0 && (
              <div class="mt-5 space-y-2">
                {s.arcos.map((a) => (
                  <a href={`/sagas/${a.slug}/`} class="flex items-center justify-between rounded-lg bg-crema-2 px-3 py-2 text-[0.88rem] font-bold text-vino hover:bg-crema-3">
                    <span>Arco: {a.nombre} ({a.total} partes)</span>
                    <Icon nombre="flecha" tamano={15} />
                  </a>
                ))}
              </div>
            )}

            <a href={`/sagas/${s.slug}/`} class="boton boton-primario mt-6">
              Entrar a la saga <Icon nombre="flecha" tamano={16} />
            </a>
          </div>
        </section>
      ))}
    </div>

    {sueltos.length > 0 && (
      <section class="mt-14">
        <h2 class="text-[1.8rem]">Cuentos independientes</h2>
        <p class="mt-1 text-tinta-suave">Historias que aún no pertenecen a una saga.</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {sueltos.map((c) => (
            <a href={`/${c.data.slug}/`} class="rounded-full border border-borde bg-white px-4 py-2 text-[0.9rem] font-bold text-tinta hover:border-vino/30 hover:text-vino">
              {c.data.title}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
