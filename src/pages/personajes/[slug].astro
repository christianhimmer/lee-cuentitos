---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import TopBar from '../../components/TopBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import StoryCard from '../../components/StoryCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PersonajeAvatar from '../../components/PersonajeAvatar.astro';
import { cuentosDePersonaje, sagas, personajes, personajesPorSlug, todosLosCuentos } from '../../lib/cuentos';
import { portadaDe } from '../../lib/imagenes';

export async function getStaticPaths() {
  return personajes.map((p) => ({ params: { slug: p.slug }, props: { personaje: p } }));
}

const { personaje } = Astro.props;
const cuentos = await cuentosDePersonaje(personaje.slug);
const saga = sagas.find((s) => s.slug === personaje.saga);
const companeros = (saga?.personajes ?? [])
  .map((s) => personajesPorSlug[s])
  .filter((p) => p && p.slug !== personaje.slug);

const todos = await todosLosCuentos();
const imagenSocial = portadaDe(cuentos[0]?.data.portada ?? todos[0].data.portada).src;

const migas = [
  { texto: 'Inicio', href: '/' },
  { texto: 'Personajes', href: '/personajes/' },
  { texto: personaje.nombre },
];
---

<Base
  titulo={`${personaje.nombre} — personaje de los cuentos`}
  descripcion={`${personaje.descripcion} Aparece en ${cuentos.length} cuentos de Lee Cuentitos.`}
  imagen={imagenSocial}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: personaje.nombre,
    description: personaje.descripcion,
    url: `https://leecuentitos.com/personajes/${personaje.slug}/`,
    memberOf: {
      '@type': 'CreativeWorkSeries',
      name: saga?.nombre ?? 'Lee Cuentitos',
      url: `https://leecuentitos.com/sagas/${saga?.slug ?? ''}/`,
    },
  }}
>
  <TopBar slot="header" />
  <Header slot="header" />
  <Footer slot="footer" />

  <section class="border-b border-linea bg-papel-2">
    <div class="contenedor py-10">
      <Breadcrumbs items={migas} />
      <div class="flex flex-col items-start gap-8 sm:flex-row sm:items-center">
        <PersonajeAvatar personaje={personaje} clase="h-56 w-44 sm:h-64 sm:w-52" tamano={260} forma="retrato" />
        <div>
          <p class="etiqueta">{personaje.etiqueta} · {personaje.especie}</p>
          <h1 class="mt-2 text-[2.5rem] sm:text-5xl">{personaje.nombre}</h1>
          <p class="mt-3 max-w-2xl text-[1.05rem] leading-relaxed text-tinta-suave">{personaje.descripcion}</p>
          {saga && (
            <a href={`/sagas/${saga.slug}/`} class="enlace-flecha mt-5">
              Saga: {saga.nombre} <Icon nombre="flecha" tamano={15} />
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <div class="contenedor py-12">
    <div class="seccion-cabeza">
      <div>
        <span class="ojal">Sus historias</span>
        <h2 class="text-[1.8rem]">Cuentos donde aparece {personaje.nombre}</h2>
      </div>
    </div>

    <div class="cuadricula-cuentos">
      {cuentos.map((c) => <StoryCard cuento={c} compacta />)}
    </div>

    {companeros.length > 0 && (
      <section class="mt-16 border-t border-linea pt-10">
        <h2 class="text-[1.5rem]">Compañeros de aventura</h2>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {companeros.map((p) => (
            <a href={`/personajes/${p.slug}/`} class="text-[14px] font-bold text-morado underline decoration-linea underline-offset-4 hover:text-carmesi">
              {p.nombre}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
