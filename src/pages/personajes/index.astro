---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import TopBar from '../../components/TopBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import PersonajeAvatar from '../../components/PersonajeAvatar.astro';
import { todosLosCuentos, sagas } from '../../lib/cuentos';
import { personajes } from '../../data/personajes';
import { portadaDe } from '../../lib/imagenes';

const cuentos = await todosLosCuentos();
const lista = personajes
  .map((p) => ({
    ...p,
    total: cuentos.filter((c) => c.data.personajes.includes(p.slug)).length,
    sagaNombre: sagas.find((s) => s.slug === p.saga)?.nombre ?? '',
  }))
  .filter((p) => p.total > 0);
---

<Base
  titulo="Personajes de los cuentos"
  descripcion="Conoce a Tom, Lucas, Max, Damián, Guillermo y todos los personajes de Lee Cuentitos. Descubre en qué cuentos aparece cada uno."
  imagen={portadaDe(cuentos[0].data.portada).src}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Personajes de Lee Cuentitos',
    hasPart: lista.map((p) => ({
      '@type': 'Person',
      name: p.nombre,
      description: p.descripcion,
      url: `https://leecuentitos.com/personajes/${p.slug}/`,
    })),
  }}
>
  <TopBar slot="header" />
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="border-b border-linea bg-papel-2">
    <div class="contenedor py-12">
      <p class="etiqueta">Habitantes del mundo</p>
      <h1 class="mt-2 text-[2.4rem] sm:text-5xl">Personajes</h1>
      <p class="mt-3 max-w-2xl text-[1.05rem] leading-relaxed text-tinta-suave">
        Niños, perros, búhos, gusanitos y duendes. Todos viven en el mismo mundo de cuentos y
        aparecen una y otra vez en distintas historias.
      </p>
    </div>
  </div>

  <div class="contenedor py-12">
    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {lista.map((p) => (
        <a href={`/personajes/${p.slug}/`} class="group grid grid-cols-[7rem_1fr] items-start gap-5 border-t border-linea pt-6">
          <PersonajeAvatar personaje={p} clase="h-40 w-28" tamano={180} forma="retrato" />
          <div>
            <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-naranja">{p.etiqueta}</span>
            <h2 class="mt-1 font-titulo text-[1.4rem] font-semibold leading-tight text-morado group-hover:text-carmesi">{p.nombre}</h2>
            <p class="mt-1 line-clamp-3 text-[14px] leading-relaxed text-tinta-suave">{p.descripcion}</p>
            <p class="mt-2 inline-flex items-center gap-1 text-[12px] font-bold text-verde">
              {p.total} {p.total === 1 ? 'cuento' : 'cuentos'} <Icon nombre="flecha" tamano={12} />
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
