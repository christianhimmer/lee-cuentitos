---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import StoryCard from '../components/StoryCard.astro';
import AdSlot from '../components/AdSlot.astro';
import SobreEsteCuento from '../components/SobreEsteCuento.astro';
import YouTube from '../components/YouTube.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import {
  relacionados,
  anteriorYSiguiente,
  nombreSaga,
  nombreArco,
  personajesPorSlug,
  fechaLarga,
} from '../lib/cuentos';
import { portadaDe } from '../lib/imagenes';

export async function getStaticPaths() {
  const cuentos = await getCollection('cuentos', ({ data }) => !data.borrador);
  return cuentos.map((cuento) => ({ params: { slug: cuento.data.slug }, props: { cuento } }));
}

const { cuento } = Astro.props;
const { data } = cuento;
const { Content } = await render(cuento);

const relacionadosLista = await relacionados(cuento, 3);
const { anterior, siguiente } = await anteriorYSiguiente(cuento);
const saga = nombreSaga(data.saga);
const portada = portadaDe(data.portada);
const personajesCuento = data.personajes.map((p) => personajesPorSlug[p]).filter((p) => p && !p.oculto);

const migas: { texto: string; href?: string }[] = [
  { texto: 'Inicio', href: '/' },
  { texto: 'Cuentos', href: '/cuentos/' },
];
if (saga && data.saga) migas.push({ texto: saga, href: `/sagas/${data.saga}/` });
migas.push({ texto: data.title });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ShortStory',
    headline: data.title,
    name: data.title,
    description: data.resumen,
    datePublished: data.date.toISOString(),
    dateModified: (data.actualizado ?? data.date).toISOString(),
    inLanguage: 'es',
    url: `https://leecuentitos.com/${data.slug}/`,
    mainEntityOfPage: `https://leecuentitos.com/${data.slug}/`,
    image: [new URL(portada.src, Astro.site).href],
    author: { '@type': 'Organization', name: 'Lee Cuentitos', url: 'https://leecuentitos.com/' },
    editor: { '@type': 'Person', name: 'Christian Himmer', url: 'https://christianhimmer.com' },
    publisher: { '@type': 'Organization', name: 'Lee Cuentitos', url: 'https://leecuentitos.com/' },
    isAccessibleForFree: true,
    ...(data.parte && data.arco
      ? {
          isPartOf: {
            '@type': 'Book',
            name: nombreArco(data.arco),
            url: `https://leecuentitos.com/sagas/${data.saga}/`,
          },
        }
      : {}),
    about: personajesCuento.map((p) => ({ '@type': 'Person', name: p.nombre })),
  },
];
---

<Base
  titulo={data.title}
  descripcion={data.resumen}
  imagen={portada.src}
  tipo="article"
  jsonLd={jsonLd}
>
  <TopBar slot="header" />
  <Header slot="header" />
  <Footer slot="footer" />
  <div id="progreso-lectura" slot="progreso"></div>

  <article class="contenedor pt-8" id="cuento" data-lectura="normal">
    <Breadcrumbs items={migas} />

    <div class="mx-auto max-w-[52rem]">
      <p class="etiqueta">
        {data.parte ? `Parte ${String(data.parte).padStart(2, '0')}` : 'Cuento'}
        {saga ? ` · ${saga}` : ''}
      </p>

      <h1 class="mt-3 text-[2.4rem] leading-[1.05] sm:text-5xl lg:text-[3.5rem]">{data.title}</h1>

      <p class="mt-4 max-w-2xl text-[1.1rem] leading-relaxed text-tinta-suave">{data.resumen}</p>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] font-bold text-verde">
        <span class="inline-flex items-center gap-1.5"><Icon nombre="reloj" tamano={14} /> {data.minutos} min de lectura</span>
        <span aria-hidden="true" class="text-linea">|</span>
        <time datetime={data.date.toISOString()}>{fechaLarga(data.date)}</time>
        {personajesCuento.length > 0 && (
          <>
            <span aria-hidden="true" class="text-linea">|</span>
            <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
              {personajesCuento.map((p, i) => (
                <span class="inline-flex items-center gap-2">
                  {i > 0 && <span aria-hidden="true" class="text-linea">·</span>}
                  <a href={`/personajes/${p.slug}/`} class="font-bold text-verde underline decoration-linea decoration-1 underline-offset-4 hover:text-morado">
                    {p.nombre}
                  </a>
                </span>
              ))}
            </span>
          </>
        )}
      </div>
    </div>

    <figure class="mx-auto mt-8 max-w-[64rem]">
      <Image
        src={portada}
        alt={data.portadaAlt ?? data.title}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1024px) 1024px, 94vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[16/9] w-full rounded-[2px] object-cover"
      />
    </figure>

    <div class="sticky top-[4.5rem] z-30 mx-auto mt-8 max-w-[52rem] border-y border-linea bg-papel/95 py-1 backdrop-blur">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-1" role="group" aria-label="Tamaño de letra">
          <span class="mr-1 hidden text-[10px] font-bold uppercase tracking-[0.14em] text-tinta-suave sm:inline">Letra</span>
          <button type="button" class="control-lectura" data-tamano="pequena" aria-label="Letra más pequeña">A−</button>
          <button type="button" class="control-lectura control-activo" data-tamano="normal" aria-label="Letra normal">A</button>
          <button type="button" class="control-lectura" data-tamano="grande" aria-label="Letra más grande">A+</button>
        </div>
        <div class="flex items-center gap-1">
          <button type="button" id="boton-compartir" class="control-lectura">
            <Icon nombre="compartir" tamano={15} /> <span class="ml-1 hidden sm:inline">Compartir</span>
          </button>
          <button type="button" id="boton-imprimir" class="control-lectura">
            <Icon nombre="descargar" tamano={15} /> <span class="ml-1 hidden sm:inline">Imprimir</span>
          </button>
        </div>
      </div>
    </div>

    <div class="lectura mx-auto mt-10 max-w-[42rem]" id="texto-cuento">
      <Content />
    </div>

    <div class="mx-auto mt-12 max-w-[52rem]">
      {data.youtube && <YouTube video={data.youtube} titulo={data.title} />}
      <AdSlot formato="horizontal" />
    </div>

    {(anterior || siguiente) && (
      <nav class="mx-auto mt-14 grid max-w-[52rem] gap-4 border-t border-linea pt-8 sm:grid-cols-2" aria-label="Capítulos de la saga">
        {anterior ? (
          <a href={`/${anterior.data.slug}/`} class="group border border-linea p-5 transition-colors hover:border-morado">
            <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-tinta-suave">← Parte anterior</span>
            <p class="mt-2 font-titulo text-lg font-semibold text-morado group-hover:text-carmesi">{anterior.data.title}</p>
          </a>
        ) : (
          <span></span>
        )}
        {siguiente && (
          <a href={`/${siguiente.data.slug}/`} class="group border border-linea p-5 text-right transition-colors hover:border-morado">
            <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-tinta-suave">Parte siguiente →</span>
            <p class="mt-2 font-titulo text-lg font-semibold text-morado group-hover:text-carmesi">{siguiente.data.title}</p>
          </a>
        )}
      </nav>
    )}

    <div class="mx-auto mt-12 max-w-[52rem] border-y border-linea py-8 text-center">
      <p class="font-titulo text-xl text-morado">¿Te gustó este cuento?</p>
      <p class="mx-auto mt-2 max-w-lg text-[15px] text-tinta-suave">
        Compártelo con otra familia o síguenos en Instagram para enterarte de cada historia nueva.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href="https://www.instagram.com/leecuentitos/" target="_blank" rel="noopener" class="boton boton-secundario">
          <Icon nombre="instagram" tamano={16} /> Instagram
        </a>
        {siguiente && (
          <a href={`/${siguiente.data.slug}/`} class="boton boton-primario">
            Leer la siguiente parte <Icon nombre="flecha" tamano={16} />
          </a>
        )}
      </div>
    </div>

    <SobreEsteCuento
      fecha={data.date}
      actualizado={data.actualizado}
      minutos={data.minutos}
      saga={data.saga}
      arco={data.arco}
      parte={data.parte}
    />
  </article>

  {relacionadosLista.length > 0 && (
    <section class="seccion mt-16">
      <div class="contenedor">
        <div class="seccion-cabeza">
          <div>
            <span class="ojal">Del mismo mundo</span>
            <h2>También te puede gustar</h2>
          </div>
          <a class="mas" href="/cuentos/">Ver todos →</a>
        </div>
        <div class="cuadricula-cuentos">
          {relacionadosLista.map((c) => <StoryCard cuento={c} compacta />)}
        </div>
      </div>
    </section>
  )}

  <script>
    const barra = document.getElementById('progreso-lectura');
    const articulo = document.getElementById('cuento');
    function actualizarProgreso() {
      if (!barra || !articulo) return;
      const inicio = articulo.offsetTop;
      const alto = articulo.offsetHeight - window.innerHeight * 0.6;
      const avance = Math.min(1, Math.max(0, (window.scrollY - inicio) / Math.max(1, alto)));
      barra.style.width = `${avance * 100}%`;
    }
    window.addEventListener('scroll', actualizarProgreso, { passive: true });
    actualizarProgreso();

    const controles = document.querySelectorAll<HTMLElement>('[data-tamano]');
    const guardado = localStorage.getItem('lc-letra');
    if (guardado) articulo?.setAttribute('data-lectura', guardado);
    function marcarActivo(tamano: string) {
      controles.forEach((b) => b.classList.toggle('control-activo', b.dataset.tamano === tamano));
    }
    if (guardado) marcarActivo(guardado);
    controles.forEach((boton) => {
      boton.addEventListener('click', () => {
        const tamano = boton.dataset.tamano ?? 'normal';
        articulo?.setAttribute('data-lectura', tamano);
        localStorage.setItem('lc-letra', tamano);
        marcarActivo(tamano);
      });
    });

    document.getElementById('boton-compartir')?.addEventListener('click', async (e) => {
      const boton = e.currentTarget as HTMLElement;
      const datos = {
        title: document.title,
        text: document.querySelector('meta[name="description"]')?.getAttribute('content') ?? '',
        url: location.href,
      };
      try {
        if (navigator.share) await navigator.share(datos);
        else {
          await navigator.clipboard.writeText(location.href);
          const original = boton.innerHTML;
          boton.innerHTML = '¡Enlace copiado!';
          setTimeout(() => (boton.innerHTML = original), 1800);
        }
      } catch (err) {}
    });

    document.getElementById('boton-imprimir')?.addEventListener('click', () => window.print());
  </script>
</Base>
