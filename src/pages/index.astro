---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import StoryCard from '../components/StoryCard.astro';
import BookHero from '../components/BookHero.astro';
import AdSlot from '../components/AdSlot.astro';
import { todosLosCuentos, sagas } from '../lib/cuentos';
import { personajesVisibles } from '../data/personajes';
import { imagen, portadaDe, retrato } from '../lib/imagenes';

const cuentos = await todosLosCuentos();
const sagaLago = cuentos
  .filter((c) => c.data.arco === 'el-misterio-del-lago-espejo' && c.data.parte && c.data.parte >= 2 && c.data.parte <= 5)
  .sort((a, b) => (a.data.parte ?? 0) - (b.data.parte ?? 0));
const recientes = cuentos.slice(0, 6);

const conteoSagas = sagas.map((s) => ({
  ...s,
  total: cuentos.filter((c) => c.data.saga === s.slug).length,
}));

const [sagaPrincipal, ...sagasSecundarias] = conteoSagas;
const personajesDestacados = personajesVisibles.slice(0, 6);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Lee Cuentitos',
    url: 'https://leecuentitos.com/',
    inLanguage: 'es',
    description:
      'Cuentos infantiles ilustrados en español para leer en familia y practicar la lectura.',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://leecuentitos.com/buscar/?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Lee Cuentitos',
      url: 'https://leecuentitos.com/',
      logo: { '@type': 'ImageObject', url: 'https://leecuentitos.com/favicon.svg' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Lee Cuentitos',
    hasPart: cuentos.slice(0, 12).map((c) => ({
      '@type': 'CreativeWork',
      name: c.data.title,
      url: `https://leecuentitos.com/${c.data.slug}/`,
    })),
  },
];
---

<Base
  titulo="Lee Cuentitos — Cuentos infantiles para leer en familia"
  descripcion="Cuentos infantiles ilustrados en español para leer en familia. Sagas de aventuras con Tom, Lucas y Max, Damián y Guijarro. Gratis y sin registro."
  imagen={portadaDe(cuentos[0].data.portada).src}
  jsonLd={jsonLd}
>
  <TopBar slot="header" />
  <Header slot="header" />
  <Footer slot="footer" />

  <h1 class="solo-lectura">Lee Cuentitos — cuentos infantiles para leer en familia</h1>

  <BookHero />

  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <span class="ojal">La saga continúa</span>
          <h2>Sigue la aventura</h2>
        </div>
        <a class="mas" href="/cuentos/">Ver todos los cuentos →</a>
      </div>
      <div class="cuadricula-cuentos">
        {sagaLago.map((c, i) => <StoryCard cuento={c} prioridad={i === 0} compacta />)}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <span class="ojal">Tres mundos</span>
          <h2>Explora por saga</h2>
        </div>
        <a class="mas" href="/sagas/">Todas las sagas →</a>
      </div>

      <div class="sagas">
        <a class="saga-grande" href={`/sagas/${sagaPrincipal.slug}/`}>
          <Image
            src={imagen(sagaPrincipal.portada)}
            alt=""
            width={900}
            height={600}
            widths={[600, 1000]}
            sizes="(min-width: 900px) 62vw, 92vw"
            loading="lazy"
          />
          <span class="conteo">{sagaPrincipal.total} cuentos</span>
          <h3>{sagaPrincipal.nombre}</h3>
          <p>{sagaPrincipal.lema}</p>
        </a>

        <div class="saga-lista">
          {sagasSecundarias.map((s) => (
            <a class="saga-pequena" href={`/sagas/${s.slug}/`}>
              <Image
                src={imagen(s.portada)}
                alt=""
                width={420}
                height={300}
                widths={[300, 520]}
                sizes="(min-width: 900px) 22vw, 38vw"
                loading="lazy"
              />
              <div class="txt">
                <span class="conteo">{s.total} cuentos</span>
                <h3>{s.nombre}</h3>
                <p>{s.lema}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <span class="ojal">Quiénes viven estas historias</span>
          <h2>Conoce a los personajes</h2>
        </div>
        <a class="mas" href="/personajes/">Ver todos →</a>
      </div>
      <div class="personajes-tira">
        {personajesDestacados.map((p) => (
          <a class="personaje-ficha" href={`/personajes/${p.slug}/`}>
            {p.foto ? (
              <Image
                src={retrato(p.foto)!}
                alt={p.nombre}
                width={220}
                height={220}
                widths={[180, 260]}
                sizes="190px"
                loading="lazy"
                class="h-[190px] w-auto object-contain"
              />
            ) : (
              <span class="grid h-[190px] w-[120px] place-items-center font-titulo text-3xl text-morado">{p.iniciales}</span>
            )}
            <span class="nombre">{p.nombre}</span>
            <span class="rol">{p.etiqueta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabeza">
        <div>
          <span class="ojal">Recién publicados</span>
          <h2>Últimos cuentos</h2>
        </div>
        <a class="mas" href="/cuentos/">Ir a la biblioteca →</a>
      </div>
      <div class="grid grid-cols-1 gap-x-7 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
        {recientes.map((c) => <StoryCard cuento={c} />)}
      </div>
      <div class="mt-14">
        <AdSlot formato="horizontal" />
      </div>
    </div>
  </section>

  <section class="filosofia">
    <div class="contenedor">
      <p class="frase">Cada cuento nació porque un niño pidió otro.</p>
      <p class="texto">
        Lee Cuentitos empezó como una tarea de lectura y terminó siendo un mundo. No hay
        registro, no hay costo y no hay prisa: solo historias para leer en voz alta,
        practicar y volver a pedir.
      </p>
      <p class="firma"><span></span> Christian, papá de Damián</p>
    </div>
    <Logo variante="agua" />
  </section>
</Base>
